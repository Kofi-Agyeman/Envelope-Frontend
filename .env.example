# Base URL of the FastAPI backend that fronts MTN MoMo. Must include the /api
# prefix -- every route lives under it (/api/auth/login, /api/users/me, ...).
# Leave unset to use the default http://10.97.233.207:8000/api.
# An Android emulator reaches the host machine at 10.0.2.2 instead:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# EXPO_PUBLIC_API_URL=https://api.envelope.app/api

#
# SECURITY
#
# This file must never contain MTN API keys, MTN API secrets, JWT signing
# secrets, database credentials or any other backend secret. The mobile app
# talks to the FastAPI backend over HTTPS and holds only a short-lived user
# access token.
