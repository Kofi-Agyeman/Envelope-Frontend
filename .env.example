# Base URL of the FastAPI backend that fronts MTN MoMo.
# Leave unset to run entirely against the bundled mock service.
# EXPO_PUBLIC_API_URL=https://api.pingpay.app

# Public base URL of the PingPay web app, used to build envelope links when the
# backend does not return a full share URL.
# EXPO_PUBLIC_WEB_URL=https://pingpay.app

# Set to "false" to force real network calls even when no API URL is present.
# EXPO_PUBLIC_USE_MOCKS=true

#
# SECURITY
#
# This file must never contain MTN API keys, MTN API secrets, JWT signing
# secrets, database credentials or any other backend secret. The mobile app
# talks to the FastAPI backend over HTTPS and holds only a short-lived user
# access token.
